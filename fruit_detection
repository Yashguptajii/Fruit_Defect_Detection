# ----------------------------------------------------------------------------
# Fruit profiles
# ----------------------------------------------------------------------------
@dataclass(frozen=True)
class Profile:
    name: str
    hues: Tuple[Tuple[int, int], ...]                 # OpenCV hue ranges (0-179) of the HEALTHY skin
    reject_pct: float           # % of surface damaged -> REJECT
    warn_pct: float             # % of surface damaged -> MINOR DEFECTS
    v_range: Tuple[int, int] = (0, 255)   # expected median brightness (auto-detect only)
    elongated: bool = False     # banana-like shape
    dark_fruit: bool = False    # naturally dark skin (plum, pomegranate)
    mold_check: bool = True     # look for green/blue mould (off for green fruit)
    dark_delta: float = 30.0    # local darkness needed to count as a defect
    auto: bool = True           # may be chosen by auto-detect


PROFILES = [
    Profile("Red Apple / Tomato", ((0, 9), (165, 179)), 5, 1.5, v_range=(110, 255)),
    Profile("Pomegranate",        ((0, 9), (165, 179)), 6, 2.0, v_range=(0, 150),
            dark_fruit=True, dark_delta=38),
    Profile("Strawberry",         ((0, 8), (168, 179)), 6, 2.0, auto=False, dark_delta=36),
    Profile("Orange",             ((5, 20),), 5, 1.5),
    Profile("Mango",              ((18, 40),), 6, 2.0, mold_check=False),
    Profile("Banana",             ((20, 36),), 15, 7.0, elongated=True, mold_check=False,
            dark_delta=42),
    Profile("Lemon",              ((22, 36),), 5, 1.5, mold_check=False, auto=False),
    Profile("Guava",              ((28, 60),), 5, 1.5, mold_check=False),
    Profile("Green Apple",        ((45, 85),), 5, 1.5, mold_check=False),
    Profile("Plum / Grape",       ((115, 165),), 6, 2.0, dark_fruit=True, dark_delta=40),
]
GENERIC = Profile("Generic Fruit", ((0, 179),), 5, 1.5)


def ellipse(k: int) -> np.ndarray:
    return cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (k, k))


