def render_demo(spec: dict, size: Tuple[int, int] = (480, 640)) -> np.ndarray:
    H, W = size
    rng = np.random.default_rng(spec.get("seed", 1))
    yy, xx = np.mgrid[0:H, 0:W].astype(np.float32)
    bg = np.full((H, W, 3), (238, 238, 236), np.float32) * (1 - 0.06 * yy / H)[..., None]
    cx, cy = 320, 240

    body = np.zeros((H, W), np.uint8)
    if spec.get("shape") == "ellipse":
        cv2.ellipse(body, (cx, cy), spec["axes"], spec.get("angle", 0), 0, 360, 255, -1)
        rad = spec["axes"][0] * 0.6
    else:
        rad = spec.get("r", 100)
        cv2.circle(body, (cx, cy), rad, 255, -1)

    shadow = cv2.GaussianBlur(np.roll(body, 18, axis=0).astype(np.float32) / 255, (0, 0), 14)
    bg *= (1 - 0.22 * shadow)[..., None]

    d = np.sqrt(((xx - (cx - 0.35 * rad)) / rad) ** 2 + ((yy - (cy - 0.4 * rad)) / rad) ** 2)
    shade = np.clip(1.18 - 0.42 * d, 0.55, 1.15)
    fruit = np.array(spec["color"], np.float32)[None, None, :] * shade[..., None]
    fruit += rng.normal(0, 4, (H, W, 1)).astype(np.float32)

    for (x, y, rx, ry, c) in spec.get("defects", []):
        a = np.zeros((H, W), np.float32)
        cv2.ellipse(a, (x, y), (rx, ry), 0, 0, 360, 1, -1)
        a = cv2.GaussianBlur(a, (0, 0), 2.5)[..., None]
        fruit = fruit * (1 - a) + np.array(c, np.float32) * (0.6 + 0.4 * shade[..., None]) * a

    for _ in range(spec.get("specks", 0)):
        px = int(cx + rng.uniform(-0.8, 0.8) * rad)
        py = int(cy + rng.uniform(-0.3, 0.3) * rad)
        a = np.zeros((H, W), np.float32)
        cv2.circle(a, (px, py), 3, 1, -1)
        a = cv2.GaussianBlur(a, (0, 0), 1)[..., None]
        fruit = fruit * (1 - a) + np.array((25, 55, 90), np.float32) * a

    alpha = cv2.GaussianBlur(body.astype(np.float32) / 255, (0, 0), 1.2)[..., None]
    img = fruit * alpha + bg * (1 - alpha)

    if spec.get("stem"):
        col, (rx, ry) = spec["stem"]
        cv2.ellipse(img, (cx, cy - rad + 8), (rx, ry), 0, 0, 360, col, -1)

    g = np.exp(-((xx - (cx - 0.4 * rad)) ** 2 + (yy - (cy - 0.45 * rad)) ** 2) / (2 * (0.1 * rad) ** 2))
    img += (255 - img) * 0.9 * (g * alpha[..., 0])[..., None]
    img += rng.normal(0, 2.5, img.shape)
    return np.clip(img, 0, 255).astype(np.uint8)


# ----------------------------------------------------------------------------
# Core image-processing functions
# ----------------------------------------------------------------------------
def segment_fruit(roi: np.ndarray, bg_ref: Optional[np.ndarray] = None) -> Optional[dict]:
    """Return dict(mask, contour, bg_med, ratio, aspect) or None if the box is empty."""
    h, w = roi.shape[:2]
    lab = cv2.cvtColor(cv2.GaussianBlur(roi, (7, 7), 0), cv2.COLOR_BGR2LAB).astype(np.float32)

    m = 10
    ring = np.zeros((h, w), bool)
    ring[:m, :] = ring[-m:, :] = ring[:, :m] = ring[:, -m:] = True

    if bg_ref is not None and bg_ref.shape == lab.shape:
        ref, thr = bg_ref, 16.0
        bg_med = np.median(bg_ref.reshape(-1, 3), axis=0)
    else:
        samples = lab[ring]
        bg_med = np.median(samples, axis=0)
        ref = bg_med
        dv = samples - bg_med
        noise = np.sqrt((0.4 * dv[:, 0].std()) ** 2 + dv[:, 1].std() ** 2 + dv[:, 2].std() ** 2)
        thr = max(14.0, 4.0 * noise)

    diff = lab - ref
    dist = np.sqrt((0.4 * diff[..., 0]) ** 2 + diff[..., 1] ** 2 + diff[..., 2] ** 2)
    mask = (dist > thr).astype(np.uint8) * 255
    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, ellipse(5))
    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, ellipse(15))

    cnts, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    if not cnts:
        return None
    c = max(cnts, key=cv2.contourArea)
    area = cv2.contourArea(c)
    if area < 0.04 * h * w:
        return None

    hull = cv2.convexHull(c)
    if area / max(cv2.contourArea(hull), 1.0) > 0.9:   # convex fruit -> fill rot at the edge
        c = hull
    full = np.zeros((h, w), np.uint8)
    cv2.drawContours(full, [c], -1, 255, -1)
    (_, _), (rw, rh), _ = cv2.minAreaRect(c)
    return dict(mask=full, contour=c, bg_med=bg_med,
                ratio=cv2.countNonZero(full) / float(h * w),
                aspect=max(rw, rh) / max(min(rw, rh), 1.0))


def white_balance(roi: np.ndarray, bg_lab: np.ndarray) -> np.ndarray:
    """Shift Lab a/b so a neutral background becomes neutral (skip for coloured backgrounds)."""
    da, db = bg_lab[1] - 128.0, bg_lab[2] - 128.0
    if np.hypot(da, db) > 22:
        return roi
    lab = cv2.cvtColor(roi, cv2.COLOR_BGR2LAB).astype(np.float32)
    lab[..., 1] -= da
    lab[..., 2] -= db
    return cv2.cvtColor(np.clip(lab, 0, 255).astype(np.uint8), cv2.COLOR_LAB2BGR)


def auto_profile(hsv: np.ndarray, valid: np.ndarray, aspect: float) -> Profile:
    H, S, V = cv2.split(hsv)
    sel = valid & (S > 60) & (V > 70)
    if sel.sum() < 300:
        return GENERIC
    hh = H[sel]
    med_v = float(np.median(V[valid]))
    best, best_score = GENERIC, 0.35
    for p in PROFILES:
        if not p.auto:
            continue
        inr = np.zeros(hh.shape, bool)
        for lo, hi in p.hues:
            inr |= (hh >= lo) & (hh <= hi)
        score = float(inr.mean())
        if not (p.v_range[0] <= med_v <= p.v_range[1]):
            score *= 0.4
        if p.elongated:
            score *= 1.15 if aspect > 1.9 else 0.5
        elif aspect > 2.2:
            score *= 0.6
        if score > best_score:
            best, best_score = p, score
    return best


def masked_smooth(img: np.ndarray, m: np.ndarray, sigma: float) -> np.ndarray:
    mf = m.astype(np.float32)
    num = cv2.GaussianBlur(img * mf, (0, 0), sigma)
    den = cv2.GaussianBlur(mf, (0, 0), sigma)
    return num / np.maximum(den, 1e-3)


def detect_defects(roi: np.ndarray, fruit_mask: np.ndarray, prof_getter, aspect: float,
                   sens: float = 1.0, forced: Optional[Profile] = None) -> Optional[dict]:
    """Returns dict(mask, boxes, pct, blobs, largest, profile) or None."""
    h, w = fruit_mask.shape
    area = cv2.countNonZero(fruit_mask)
    eq_d = np.sqrt(4.0 * area / np.pi)

    img = cv2.bilateralFilter(roi, 7, 35, 7)
    hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)
    H, S, V = cv2.split(hsv)
    Vf = V.astype(np.float32)
    lab = cv2.cvtColor(img, cv2.COLOR_BGR2LAB).astype(np.float32)
    L = lab[..., 0]

    # -- valid analysis area: inside fruit, away from the edge, no glare
    prof_dark_hint = forced.dark_fruit if forced is not None else True
    r = max(3, int(0.06 * eq_d))
    inner = cv2.erode(fruit_mask, ellipse(2 * r + 1))
    glare = (((V > 225) & (S < 70)).astype(np.uint8)) * 255
    glare = cv2.dilate(glare, ellipse(15 if prof_dark_hint else 9))
    valid = (inner > 0) & (glare == 0)
    nvalid = int(valid.sum())
    if nvalid < 500:
        return None

    prof = forced if forced is not None else prof_getter(hsv, valid, aspect)

    # -- A: local darkness relative to smooth illumination (iterated, defects excluded)
    sigma = max(8.0, 0.12 * eq_d)
    ref = valid.copy()
    cand = np.zeros((h, w), bool)
    thr_dark = prof.dark_delta / sens
    for _ in range(3):
        Ls = masked_smooth(L, ref, sigma)
        cand = ((Ls - L) > thr_dark) & valid
        grown = cv2.dilate(cand.astype(np.uint8), ellipse(9)) > 0
        new_ref = valid & ~grown
        if new_ref.sum() < 0.3 * nvalid:
            break
        ref = new_ref

    med_L = float(np.median(L[ref]))
    med_V = float(np.median(Vf[ref]))
    med_lab = np.median(lab[ref], axis=0)

    # -- B: absolute darkness vs. the fruit's own brightness
    dark_abs = (Vf < (0.30 if prof.dark_fruit else 0.50) * med_V) & valid

    # -- C: colour shift + darker (brown / black rot)
    dE = np.sqrt(0.5 * (L - med_lab[0]) ** 2 + (lab[..., 1] - med_lab[1]) ** 2 +
                 (lab[..., 2] - med_lab[2]) ** 2)
    if prof.dark_fruit:   # rot on dark skin is often a dull colour change, not darker
        shift = (dE > 40.0 / sens) & valid
    else:
        shift = (dE > 42.0 / sens) & (L < med_L - 12) & valid

    defect = cand | dark_abs | shift

    # -- D: green / blue-green mould on non-green fruit
    if prof.mold_check:
        mold = ((H >= 38) & (H <= 105) & (S > 45) & (V > 50) & valid)
        defect |= mold

    d = defect.astype(np.uint8) * 255
    d = cv2.morphologyEx(d, cv2.MORPH_OPEN, ellipse(3))
    d = cv2.morphologyEx(d, cv2.MORPH_CLOSE, ellipse(7))
    d = cv2.bitwise_and(d, valid.astype(np.uint8) * 255)

    # -- keep real blobs only (drop specks, and small stem/calyx blobs at the top)
    ys, xs = np.where(fruit_mask > 0)
    top, height = ys.min(), max(ys.max() - ys.min(), 1)
    min_area = max(30, 0.0015 * area)
    cnts, _ = cv2.findContours(d, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    keep = np.zeros_like(d)
    boxes, areas = [], []
    for c in cnts:
        a = cv2.contourArea(c)
        if a < min_area:
            continue
        bx, by, bw, bh = cv2.boundingRect(c)
        cy_ = by + bh / 2.0
        if (cy_ - top) < 0.18 * height and a < 0.025 * area and not prof.elongated:
            continue                       # stem / calyx
        cv2.drawContours(keep, [c], -1, 255, -1)
        boxes.append((bx, by, bw, bh))
        areas.append(a)

    npx = cv2.countNonZero(keep)
    pct = 100.0 * npx / nvalid
    largest = 100.0 * (max(areas) if areas else 0) / nvalid
    return dict(mask=keep, boxes=boxes, pct=pct, blobs=len(boxes), largest=largest,
                profile=prof, valid=valid)


# ----------------------------------------------------------------------------
# Inspector (state + drawing)
# ----------------------------------------------------------------------------
class FruitInspector:
    def __init__(self) -> None:
        self.bg_ref: Optional[np.ndarray] = None
        self.manual: Optional[int] = None          # None = AUTO, else index into PROFILES
        self.sens: float = 1.0
        self.pct_hist: deque = deque(maxlen=8)
        self.blob_hist: deque = deque(maxlen=8)
        self.prof_votes: deque = deque(maxlen=15)

    def reset_history(self) -> None:
        self.pct_hist.clear()
        self.blob_hist.clear()
        self.prof_votes.clear()

    def calibrate(self, frame: np.ndarray, box: Tuple[int, int, int, int]) -> None:
        x1, y1, x2, y2 = box
        roi = cv2.GaussianBlur(frame[y1:y2, x1:x2], (7, 7), 0)
        self.bg_ref = cv2.cvtColor(roi, cv2.COLOR_BGR2LAB).astype(np.float32)

    def cycle_profile(self) -> None:
        if self.manual is None:
            self.manual = 0
        elif self.manual + 1 >= len(PROFILES):
            self.manual = None
        else:
            self.manual += 1
        self.reset_history()

    def _profile_getter(self, hsv: np.ndarray, valid: np.ndarray, aspect: float) -> Profile:
        p = auto_profile(hsv, valid, aspect)
        self.prof_votes.append(p.name)
        winner = Counter(self.prof_votes).most_common(1)[0][0]
        return next((q for q in PROFILES if q.name == winner), GENERIC)

    def analyze(self, frame: np.ndarray, box: Tuple[int, int, int, int]) -> Tuple[np.ndarray, np.ndarray, dict]:
        x1, y1, x2, y2 = box
        roi = frame[y1:y2, x1:x2].copy()
        view = np.full(roi.shape, 40, np.uint8)
        info = dict(state="EMPTY", pct=0.0, profile="-", blobs=0)

        seg = segment_fruit(roi, self.bg_ref)
        if seg is None:
            self.reset_history()
            return self._finish(frame, roi, view, box, info, seg, None)
        if seg["ratio"] > 0.85:
            self.reset_history()
            info["state"] = "TOO_BIG"
            return self._finish(frame, roi, view, box, info, seg, None)

        roi_wb = white_balance(roi, seg["bg_med"])
        forced = PROFILES[self.manual] if self.manual is not None else None
        res = detect_defects(roi_wb, seg["mask"], self._profile_getter, seg["aspect"],
                             self.sens, forced)
        if res is None:
            info["state"] = "EMPTY"
            return self._finish(frame, roi, view, box, info, seg, None)

        self.pct_hist.append(res["pct"])
        self.blob_hist.append(res["blobs"])
        pct = float(np.median(self.pct_hist))
        blobs = int(np.median(self.blob_hist))
        prof = res["profile"]

        if len(self.pct_hist) < 4:
            state = "ANALYZING"
        elif pct >= prof.reject_pct or (blobs >= 6 and pct >= 0.5 * prof.reject_pct):
            state = "ROTTEN"
        elif pct >= prof.warn_pct:
            state = "MINOR"
        else:
            state = "FRESH"
        info.update(state=state, pct=pct, profile=prof.name + ("" if forced else " (auto)"),
                    blobs=blobs)
        return self._finish(frame, roi, view, box, info, seg, res)

    def _finish(self, frame: np.ndarray, roi: np.ndarray, view: np.ndarray, box: Tuple[int, int, int, int],
                info: dict, seg: Optional[dict], res: Optional[dict]) -> Tuple[np.ndarray, np.ndarray, dict]:
        x1, y1, x2, y2 = box
        colors = {"FRESH": (0, 200, 0), "MINOR": (0, 200, 255), "ROTTEN": (0, 0, 255),
                  "ANALYZING": (255, 200, 0), "EMPTY": (255, 255, 255), "TOO_BIG": (0, 165, 255)}
        col = colors[info["state"]]

        if seg is not None:
            view[seg["mask"] > 0] = 90
            cv2.drawContours(roi, [seg["contour"]], -1, (255, 255, 0), 2)
        if res is not None:
            tint = roi.copy()
            tint[res["mask"] > 0] = (0, 0, 255)
            roi = cv2.addWeighted(tint, 0.45, roi, 0.55, 0)
            view[res["mask"] > 0] = 255
            for bx, by, bw, bh in res["boxes"]:
                cv2.rectangle(roi, (bx, by), (bx + bw, by + bh), (0, 0, 255), 2)

        frame[y1:y2, x1:x2] = roi
        cv2.rectangle(frame, (x1, y1), (x2, y2), col, 3)

        texts = {
            "EMPTY": "PLACE FRUIT IN BOX",
            "TOO_BIG": "FRUIT TOO LARGE - MOVE IT BACK",
            "ANALYZING": "ANALYZING... HOLD STEADY",
            "FRESH": f"GOOD - FRESH ({info['pct']:.1f}% damaged)",
            "MINOR": f"ACCEPTABLE - MINOR DEFECTS ({info['pct']:.1f}%)",
            "ROTTEN": f"REJECTED - ROTTEN ({info['pct']:.1f}% damaged)",
        }
        cv2.rectangle(frame, (0, 0), (frame.shape[1], 62), (20, 20, 20), -1)
        cv2.putText(frame, texts[info["state"]], (15, 28), cv2.FONT_HERSHEY_SIMPLEX, 0.8, col, 2)
        cv2.putText(frame, f"Fruit: {info['profile']} | spots: {info['blobs']} | "
                           f"sensitivity x{self.sens:.2f}",
                    (15, 52), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (220, 220, 220), 1)
        cv2.putText(frame, "Calibrated BG" if self.bg_ref is not None else "Auto BG",
                    (frame.shape[1] - 130, 52), cv2.FONT_HERSHEY_SIMPLEX, 0.45, (180, 180, 180), 1)
        return frame, view, info


# ----------------------------------------------------------------------------
# Main loop
# ----------------------------------------------------------------------------
def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--cam", type=int, default=0, help="camera index")
    ap.add_argument("--demo", action="store_true", help="start in demo mode")
    args = ap.parse_args()

    cap = cv2.VideoCapture(args.cam)
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
    demo_mode = args.demo or not cap.isOpened()
    demo_idx = 0
    insp = FruitInspector()

    print(__doc__)
    print("TIPS: plain light background, even light from the front/sides, no strong "
          "reflections. Press 'b' with an EMPTY box to calibrate the background.")

    while True:
        if demo_mode:
            frame = render_demo(DEMO_SAMPLES[demo_idx])
        else:
            ok, frame = cap.read()
            if not ok:
                print("Webcam unavailable -> demo mode.")
                demo_mode = True
                continue
            frame = cv2.flip(frame, 1)

        hgt, wid = frame.shape[:2]
        x1, y1 = (wid - ROI_SIZE) // 2, (hgt - ROI_SIZE) // 2 + 20
        box = (x1, y1, x1 + ROI_SIZE, y1 + ROI_SIZE)

        raw = frame.copy()
        out, view, info = insp.analyze(frame, box)

        # lighting warning (uses the box border brightness)
        bright = float(np.mean(cv2.cvtColor(raw[y1:y1 + 10, x1:x1 + ROI_SIZE], cv2.COLOR_BGR2GRAY)))
        if not demo_mode and (bright < 70 or bright > 245):
            cv2.putText(out, "LIGHTING POOR - results unreliable", (15, hgt - 40),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.55, (0, 200, 255), 2)
        if demo_mode:
            cv2.putText(out, f"DEMO: {DEMO_SAMPLES[demo_idx]['name']}  [n] next  [d] exit",
                        (15, hgt - 15), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (30, 30, 30), 1)

        cv2.imshow("Fruit Quality Inspector", out)
        cv2.imshow("Defect Mask (white = damage, grey = fruit)", view)

        key = cv2.waitKey(30 if demo_mode else 1) & 0xFF
        if key == ord("q"):
            break
        elif key == ord("d"):
            demo_mode = not demo_mode
            insp.reset_history()
        elif key == ord("n") and demo_mode:
            demo_idx = (demo_idx + 1) % len(DEMO_SAMPLES)
            insp.reset_history()
        elif key == ord("f"):
            insp.cycle_profile()
        elif key == ord("b"):
            insp.calibrate(raw, box)
            insp.reset_history()
            print("Background calibrated (box must have been empty).")
        elif key == ord("c"):
            insp.bg_ref = None
            insp.reset_history()
        elif key in (ord("+"), ord("=")):
            insp.sens = min(2.0, insp.sens + 0.1)
        elif key in (ord("-"), ord("_")):
            insp.sens = max(0.5, insp.sens - 0.1)
        elif key == ord("s"):
            cv2.imwrite("fruit_snapshot.png", out)
            cv2.imwrite("defect_mask.png", view)
            print("Saved fruit_snapshot.png and defect_mask.png")

    cap.release()
    cv2.destroyAllWindows()


if __name__ == "__main__":
    main()